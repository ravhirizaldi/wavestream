# Wavestream — production environment template.
#
# Copy to `.env.production` and edit values. The real `.env.production` is
# gitignored. `start.sh` sources it automatically when present.

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8880

# ── Whisper ─────────────────────────────────────────────────────────────────
WHISPER_BACKEND=faster-whisper
# Best production balance for this real-time app: much faster than large-v3,
# still high quality for multilingual speech. Use openai/whisper-large-v3 if
# you prefer maximum accuracy over latency.
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo
WHISPER_COMPUTE_TYPE=float16
# Beam search keeps output stable without the cost of very wide decoding.
WHISPER_NUM_BEAMS=3
WHISPER_CPU_THREADS=4
WHISPER_CONCURRENCY=2
WHISPER_CHUNK_LENGTH_SECONDS=12
WHISPER_SHORT_AUDIO_THRESHOLD_SECONDS=12.0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=350
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.2
WHISPER_LOG_PROB_THRESHOLD=-0.8
WHISPER_NO_SPEECH_THRESHOLD=0.6

# ── Machine translation ─────────────────────────────────────────────────────
# NLLB gives better multilingual output for normal speech transcripts.
# Set MT_BACKEND=opus to use the legacy Helsinki-NLP Marian/Opus models below.
MT_BACKEND=nllb
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M

# ── OpusMT ──────────────────────────────────────────────────────────────────
OPUS_ID_MODEL_ID=Helsinki-NLP/opus-mt-en-id
OPUS_JA_MODEL_ID=Helsinki-NLP/opus-mt-en-jap
OPUS_PT_MODEL_ID=Helsinki-NLP/opus-mt-en-ROMANCE
OPUS_TL_MODEL_ID=Helsinki-NLP/opus-mt-en-tl
OPUS_ID_EN_MODEL_ID=Helsinki-NLP/opus-mt-id-en
# FuGuMT — same MarianMT architecture, drop-in replacement, dramatically more
# faithful on conversational Japanese with hesitations/repetitions.
# `Helsinki-NLP/opus-mt-ja-en` collapses such inputs into stock English
# ("I'm from the United States, ...") and is no longer recommended.
OPUS_JA_EN_MODEL_ID=staka/fugumt-ja-en
OPUS_PT_EN_MODEL_ID=Helsinki-NLP/opus-mt-ROMANCE-en
OPUS_TL_EN_MODEL_ID=Helsinki-NLP/opus-mt-tl-en
OPUS_PT_TARGET_TOKEN='>>pt_BR<<'
# These generation settings are also used by the NLLB backend.
OPUS_NUM_BEAMS=2
OPUS_MAX_NEW_TOKENS=384
OPUS_NO_REPEAT_NGRAM_SIZE=3
OPUS_LENGTH_PENALTY=1.0

# ── TTS ─────────────────────────────────────────────────────────────────────
TTS_EN_MODEL_ID=facebook/mms-tts-eng
TTS_ID_MODEL_ID=facebook/mms-tts-ind
TTS_PT_MODEL_ID=facebook/mms-tts-por
TTS_TL_MODEL_ID=facebook/mms-tts-tgl
TTS_JA_MODEL_ID=suno/bark-small
TTS_JA_VOICE=v2/ja_speaker_0
TTS_SPEAKING_RATE=1.0
# Languages whose TTS backend is loaded eagerly on startup.
# Anything not listed loads lazily on first synth request.
# Default skips "ja" because Bark (~1.5 GB) dominates startup time.
# Set to "en,id,ja" to restore the previous eager-load behaviour.
TTS_PRELOAD_LANGUAGES=en,id

# ── Shared ──────────────────────────────────────────────────────────────────
# Optional. Leave empty for public Hugging Face models.
HF_TOKEN=
MODEL_DEVICE=cuda
MODEL_DTYPE=float16
CHUNK_SECONDS=15
CHUNK_OVERLAP_SECONDS=0.75
TRIM_SILENCE=true
SILENCE_THRESHOLD_RATIO=0.01
SILENCE_THRESHOLD_FLOOR=0.0015
SILENCE_PADDING_MS=180
NORMALIZE_AUDIO=true
